        .footer {
            background-color: #1a1c23;
            color: #a0a5bcd0;
            padding: 60px 20px 30px 20px;
            font-size: 14px;
        }

        .footer-content {
            max-width: 1100px;
            margin: 0 auto;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 40px;
            margin-bottom: 40px;
        }

        .footer-col h4 {
            color: #ffffff;
            font-size: 16px;
            margin-bottom: 20px;
            font-weight: 600;
        }

        .footer-col ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .footer-col ul li {
            margin-bottom: 12px;
        }

        .footer-col ul li a {
            color: #a0a5bc;
            text-decoration: none;
            transition: color 0.2s;
        }

        .footer-col ul li a:hover {
            color: #ffffff;
        }

        /* Language Dropdown Container */
        .language-selector {
            position: relative;
            display: inline-block;
            margin-bottom: 30px;
        }

        .dropbtn {
            background-color: rgba(255, 255, 255, 0.08);
            color: white;
            padding: 10px 16px;
            font-size: 14px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            bottom: 100%;
            left: 0;
            background-color: #262935;
            min-width: 160px;
            box-shadow: 0px 8px 16px rgba(0,0,0,0.3);
            border-radius: 6px;
            z-index: 1;
            margin-bottom: 6px;
        }

        .dropdown-content a {
            color: #a0a5bc;
            padding: 10px 14px;
            text-decoration: none;
            display: block;
            font-size: 13px;
        }

        .dropdown-content a:hover {
            background-color: rgba(255,255,255,0.05);
            color: #fff;
        }

        /* Show the dropdown menu on click/focus (Controlled via JS or toggle class) */
        .language-selector.active .dropdown-content {
            display: block;
        }

        .footer-divider {
            border: none;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            margin: 20px 0;
        }

        .footer-bottom-text {
            font-size: 13px;
            line-height: 1.6;
            max-width: 700px;
            margin-bottom: 30px;
        }

        .social-icons {
            display: flex;
            gap: 20px;
            font-size: 16px;
            margin-bottom: 40px;
        }

        .social-icons a {
            color: #a0a5bc;
            text-decoration: none;
        }

        .footer-brand {
            text-align: center;
            font-size: 13px;
            color: #72768d;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            padding-top: 20px;
        }
